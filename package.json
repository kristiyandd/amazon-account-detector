{
  "name": "amazon-account-detector",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome MV3 extension that shows which Amazon account is signed in on a chosen marketplace, without touching your tabs.",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "setup": "playwright install chromium",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --typecheck",
    "e2e": "playwright test",
    "knip": "knip",
    "check:privacy": "node scripts/check-no-real-emails.ts",
    "audit": "npm audit && npm audit signatures",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run knip && npm run test:coverage && npm run build && npm run e2e && npm run check:privacy && npm run audit"
  },
  "dependencies": {
    "preact": "10.29.8",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@crxjs/vite-plugin": "3.0.0",
    "@eslint-react/eslint-plugin": "5.23.5",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "2.10.6",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/eslint-plugin": "1.6.27",
    "chrome-types": "0.1.451",
    "eslint": "10.12.0",
    "eslint_d": "15.0.3",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-playwright": "2.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-unicorn": "76.0.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "knip": "6.39.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "unrs-resolver": false
  }
}
